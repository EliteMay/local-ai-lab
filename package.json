{
  "name": "local-ai-lab",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Local AI repository audit lab with a Windows Electron run controller.",
  "scripts": {
    "start": "node src/index.mjs",
    "doctor": "node src/index.mjs doctor",
    "inspect": "node src/index.mjs inspect",
    "company": "node src/index.mjs company",
    "coverage": "node src/index.mjs coverage",
    "coverage-synthesize": "node src/index.mjs coverage-synthesize",
    "test": "node --test",
    "desktop": "npm run icon:build && electron desktop/main.mjs",
    "build:win": "npm run icon:build && electron-builder --win nsis --x64 --publish never",
    "icon:build": "node scripts/generate-app-icon.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "26.15.3",
    "sharp": "^0.34.4",
    "png-to-ico": "^3.0.1"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "build": {
    "appId": "local.elitemay.localailab",
    "productName": "Local AI Lab",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "EliteMay",
        "repo": "local-ai-lab"
      }
    ],
    "files": [
      "desktop/**/*",
      "src/**/*",
      "config/**/*",
      "tests/**/*",
      "package.json",
      "README.md",
      "REQUIREMENTS.md",
      "PROJECT_LEARNINGS.md"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "local_ai_lab_${version}_setup.${ext}",
      "signAndEditExecutable": true,
      "forceCodeSigning": false,
      "icon": "desktop/assets/generated/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Local AI Lab"
    }
  },
  "main": "desktop/main.mjs"
}
