{
  "model": {
    "baseUrl": "http://127.0.0.1:1234/v1",
    "model": "qwen/qwen3-8b",
    "timeoutMs": 600000,
    "maxTokens": 2048,
    "temperature": 0.2
  },
  "limits": {
    "maxDelegationDepth": 3,
    "maxTasksPerRun": 12,
    "maxModelCalls": 20,
    "maxRetriesPerTask": 1
  },
  "orchestrator": {
    "maxReviewPasses": 2
  },
  "context": {
    "maxFiles": 12,
    "maxChars": 32000,
    "maxFileChars": 6000,
    "maxPriorResultChars": 12000
  },
  "coverage": {
    "maxChunkChars": 8000,
    "maxBatchChars": 16000,
    "batchMaxTokens": 1000,
    "singleChunkMaxTokens": 1800,
    "batchTemperature": 0.1,
    "maxSynthesisChars": 24000
  },
  "repoReader": {
    "maxFiles": 10000,
    "maxFileBytes": 2097152,
    "excludedDirectories": [
      ".git",
      "node_modules",
      "runtime-data",
      "dist",
      "build"
    ]
  },
  "runtimeData": {
    "runsRoot": "runtime-data/runs"
  }
}
